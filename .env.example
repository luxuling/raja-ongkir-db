# Required: Raja Ongkir Komerce API key (sent as HTTP header Key: ...)
RAJAONGKIR_API_KEY=

# Optional — load emitted SQL after a successful run:
# psql "$DATABASE_URL" -f sql-out/schema.sql
# psql "$DATABASE_URL" -f sql-out/seed.sql

# OUT_DIR=./sql-out
# REQUEST_DELAY_MS=100
# BATCH_SIZE=750
# MAX_RETRIES=3

# PostgreSQL table names (SQL identifiers: letters, numbers, underscore)
# TABLE_PREFIX=raja_
# TABLE_PROVINCES=raja_provinces
# TABLE_CITIES=raja_cities
# TABLE_DISTRICTS=raja_districts
# TABLE_SUB_DISTRICTS=raja_sub_districts
